.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

# /android is gitignored content-by-content (not as a single `/android`
# pattern) so the two exceptions below can survive: a directory-level
# exclusion blocks git from ever re-including anything inside it, even with
# a later `!` negation -- see the hand-maintained Gradle build-redirect
# config note below.
/android/*
!/android/build.gradle
!/android/app/
/android/app/*
!/android/app/build.gradle
!/android/init.d/
/android/init.d/*
!/android/init.d/redirect-build.gradle

# ...`android/build.gradle`, `android/app/build.gradle` and
# `android/init.d/redirect-build.gradle` are hand-maintained exceptions to
# the rule above (see docs/android-native-build-setup.md) -- they hold the
# real versionCode/versionName/signing/buildDir-redirect config (not
# regenerated by `expo prebuild`) and the fix for a real crash (2026-08-15,
# RNCDatePicker/TurboModuleRegistry). No secrets in either file -- the
# keystore password is read from `local.properties` (separately gitignored),
# never hardcoded here.

.vercel

